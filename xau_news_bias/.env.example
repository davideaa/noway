# Copia questo file come ".env" nella stessa cartella e compila i valori.
# Il file .env NON va mai nel repository (è già escluso da .gitignore).

# OBBLIGATORIO. BLS (Bureau of Labor Statistics) rifiuta le richieste
# che non indicano un contatto. Metti la tua email: serve solo a loro.
XNB_CONTACT_EMAIL=

# FACOLTATIVO, gratuito. Serve per estendere il progetto a PCE, GDP,
# payrolls con i vintage ALFRED. Si ottiene in 2 minuti su
# https://fredaccount.stlouisfed.org  ->  "API Keys"  ->  "Request API Key".
FRED_API_KEY=

# FACOLTATIVI, oggi non usati (predisposti per estensioni future).
BLS_API_KEY=
BEA_API_KEY=
TWELVEDATA_API_KEY=

# Rete: 127.0.0.1 = solo questo computer. Su un VPS dietro reverse proxy
# lascia 127.0.0.1; metti 0.0.0.0 solo se sai cosa stai facendo.
XNB_HOST=127.0.0.1
XNB_PORT=8765

# Cartella dei dati (database, cache, modelli, log). Default: ./data
# XNB_DATA_DIR=/percorso/assoluto/data
