; --- Session controls ---
NYRTHCloseHourET=16||16||0||16||N
NYRTHCloseMinuteET=0||0||0||0||N
ForceCloseAtNYRTHClose=false||false||0||false||N
AllowNewEntryIfPreviousPositionStillOpen=false||false||0||false||N
