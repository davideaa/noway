; NAS100 Session-Open Momentum v2.57
; Configurazione che ha prodotto i backtest 2019-2026:
;   PUPrime NAS100.s  1.626 operazioni, +978,7% composto, PF 1,343
;   Fusion  NAS100    1.158 operazioni, +457,4% composto, PF 1,325
; Formato di ogni riga:  nome = valore || inizio || passo || interrompi || ottimizza
; Caricare da: Strategy Tester -> scheda Input -> Load.
; QUESTO E' IL FILE DI SICUREZZA: solo i valori scelti, nessuna
; griglia, ottimizzazione spenta ovunque. Serve a NON PERDERLI.

; --- Core strategy ---
FastEMAPeriod=12||12||0||12||N
SlowEMAPeriod=120||120||0||120||N
ATRPeriod=16||16||0||16||N
ATRStopMultiplier=8.0||8.0||0||8.0||N
TrailActivationR=0.50||0.50||0||0.50||N
SignalMode=0||0||0||0||N
TrailUsesClosedBar=true||true||0||true||N
TrailMode=4||4||0||4||N
TrailATRBuffer=0.50||0.50||0||0.50||N
MaxTradesPerItalyDay=1||1||0||1||N

; --- Fixed entry filter - Mode 3 checkpoint ---
FixedMinBodyToRange=0.075||0.075||0||0.075||N
FixedMinEMADistanceATR=0.05||0.05||0||0.05||N

; --- CARD-COUNT ADAPTIVE RISK ---
RiskPercent=1.50||1.50||0||1.50||N
RiskBase=0||0||0||0||N
UseAdaptiveRisk=true||true||0||true||N
AdaptiveRiskFormula=3||3||0||3||N
AdaptiveStrength=0.50||0.50||0||0.50||N
AdaptiveReferencePeriod=200||200||0||200||N
AdaptiveShortWindow=20||20||0||20||N
AdaptiveMinMultiplier=0.50||0.50||0||0.50||N
AdaptiveMaxMultiplier=2.00||2.00||0||2.00||N
DirectionalQualityWindow=20||20||0||20||N
DirectionalQualityLow=0.20||0.20||0||0.20||N
DirectionalQualityHigh=0.45||0.45||0||0.45||N

; --- CARD-COUNT NORMALIZATION / DRAWDOWN CONTROL ---
UseRollingMarketCenter=true||true||0||true||N
MarketCenterWindow=200||200||0||200||N
MarketCenterMinSamples=20||20||0||20||N
UseEquityHealthThrottle=false||false||0||false||N
EquityThrottleK=1.00||1.00||0||1.00||N
EquityThrottleFloor=0.50||0.50||0||0.50||N
MagicNumber=1208120||1208120||0||1208120||N
MaxDeviationPoints=50||50||0||50||N
PrintDebug=false||false||0||false||N
WriteAdaptiveAuditCSV=false||false||0||false||N
WriteRegimeResearchCSV=false||false||0||false||N

; --- Broker server time -> Italy conversion ---
BrokerTimeMode=4||4||0||4||N
